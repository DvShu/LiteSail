<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LiteSail" parent="Theme.LiteSail.Base" />

    <style name="Theme.LiteSail.Scanner" parent="Theme.LiteSail.Scanner.Base" />

    <style name="Theme.LiteSail.BrowserMenu" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.48</item>
        <item name="android:windowAnimationStyle">@style/Animation.LiteSail.BrowserMenu</item>
        <item name="android:colorAccent">@color/start_page_accent</item>
    </style>

    <style name="Animation.LiteSail.BrowserMenu" parent="android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/browser_menu_enter</item>
        <item name="android:windowExitAnimation">@anim/browser_menu_exit</item>
    </style>

    <style name="Theme.LiteSail.Scanner.Base" parent="Theme.LiteSail.Base">
        <item name="android:windowBackground">@color/scanner_background</item>
        <item name="android:statusBarColor">@color/scanner_background</item>
        <item name="android:navigationBarColor">@color/scanner_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.LiteSail.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#176B73</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="Widget.LiteSail.ToolbarButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/browser_toolbar_icon</item>
    </style>

    <style name="Widget.LiteSail.BrowserMenuItem" parent="android:style/Widget.Material.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">2dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textColor">@color/start_page_brand_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.LiteSail.BrowserMenuAction" parent="Widget.LiteSail.BrowserMenuItem">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/start_page_accent</item>
    </style>

    <style name="Widget.LiteSail.QrResultButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.LiteSail.UrlShortcut" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/url_shortcut_background</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/start_page_accent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.LiteSail.SearchLinkButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/start_page_accent</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
