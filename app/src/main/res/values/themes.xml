<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LiteSail" parent="Theme.LiteSail.Teal" />

    <style name="Theme.LiteSail.Teal" parent="Theme.LiteSail.Base">
        <item name="liteSailAccent">@color/teal_accent</item>
        <item name="liteSailOnAccent">@color/teal_on_accent</item>
        <item name="liteSailAccentSurface">@color/teal_accent_surface</item>
        <item name="liteSailAccentRipple">@color/teal_accent_ripple</item>
    </style>

    <style name="Theme.LiteSail.Scanner" parent="Theme.LiteSail.Scanner.Base" />

    <style name="Theme.LiteSail.BottomSheet.Base" parent="android:style/Theme.Material.Light.Dialog.NoActionBar" />

    <style name="Theme.LiteSail.BottomSheet" parent="Theme.LiteSail.BottomSheet.Base">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.48</item>
        <item name="android:windowAnimationStyle">@style/Animation.LiteSail.BottomSheet</item>
        <item name="android:colorAccent">?attr/liteSailAccent</item>
    </style>

    <style name="Animation.LiteSail.BottomSheet" parent="android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/bottom_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/bottom_sheet_exit</item>
    </style>

    <style name="Theme.LiteSail.Scanner.Base" parent="Theme.LiteSail.Teal">
        <item name="android:windowBackground">@color/scanner_background</item>
        <item name="android:statusBarColor">@color/scanner_background</item>
        <item name="android:navigationBarColor">@color/scanner_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.LiteSail.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">?attr/liteSailAccent</item>
        <item name="android:windowBackground">@color/start_page_search_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/start_page_search_surface</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <bool name="lite_sail_light_system_bars">true</bool>

    <style name="Widget.LiteSail.StartShortcut" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:drawableTint">@color/browser_menu_foreground</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:maxLines">2</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">1dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/browser_menu_foreground</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.LiteSail.ToolbarButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/browser_menu_foreground</item>
    </style>

    <style name="Widget.LiteSail.DownloadAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/browser_toolbar_icon</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.LiteSail.LibraryTab" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">74dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/library_tab_background</item>
        <item name="android:button">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/start_page_brand_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.LiteSail.BrowserMenuItem" parent="android:style/Widget.Material.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:drawableTint">@color/browser_menu_foreground</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingHorizontal">1dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/browser_menu_foreground</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.LiteSail.BrowserMenuAction" parent="Widget.LiteSail.BrowserMenuItem">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.LiteSail.QrResultButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.LiteSail.UrlShortcut" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/url_shortcut_background</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/start_page_accent</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.LiteSail.SearchLinkButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingHorizontal">6dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/start_page_accent</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
