<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="104dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/start_page_brand_icon"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:letterSpacing="-0.035"
            android:text="@string/app_name"
            android:textColor="@color/start_page_brand_text"
            android:textSize="32sp" />

        <LinearLayout
            android:id="@+id/start_search_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/start_search_background"
            android:baselineAligned="false"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/search"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/ic_start_search"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:minWidth="0dp"
                android:minHeight="58dp"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                android:paddingVertical="10dp"
                android:text="@string/start_search_hint"
                android:textAllCaps="false"
                android:textColor="@color/start_page_search_text"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/scan_qr"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/scan_qr"
                android:scaleType="center"
                android:src="@drawable/ic_scan_qr" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/start_library"
                style="@style/Widget.LiteSail.StartShortcut"
                android:drawableTop="@drawable/ic_browser_menu_library"
                android:text="@string/browser_menu_library" />

            <Button
                android:id="@+id/start_downloads"
                style="@style/Widget.LiteSail.StartShortcut"
                android:drawableTop="@drawable/ic_browser_menu_downloads"
                android:text="@string/browser_menu_downloads" />

            <Button
                android:id="@+id/start_settings"
                style="@style/Widget.LiteSail.StartShortcut"
                android:drawableTop="@drawable/ic_menu_settings"
                android:enabled="false"
                android:text="@string/browser_menu_settings" />

            <Button
                android:id="@+id/start_bing"
                style="@style/Widget.LiteSail.StartShortcut"
                android:drawableTop="@drawable/ic_start_shortcut_bing"
                android:text="@string/start_bing" />

            <Button
                android:id="@+id/start_add_shortcut"
                style="@style/Widget.LiteSail.StartShortcut"
                android:drawableTop="@drawable/ic_start_shortcut_add"
                android:enabled="false"
                android:text="@string/start_add_shortcut" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
