<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:orientation="horizontal">

            <Button
                android:id="@+id/open_downloads"
                style="@style/Widget.LiteSail.BrowserMenuAction"
                android:drawableTop="@drawable/ic_menu_downloads"
                android:text="@string/browser_menu_downloads" />

            <Button
                android:id="@+id/open_library"
                style="@style/Widget.LiteSail.BrowserMenuAction"
                android:drawableTop="@drawable/ic_menu_library"
                android:text="@string/browser_menu_library" />

            <Button
                android:id="@+id/open_windows"
                style="@style/Widget.LiteSail.BrowserMenuAction"
                android:drawableTop="@drawable/ic_toolbar_window"
                android:text="@string/browser_windows" />

            <Button
                android:id="@+id/toggle_incognito"
                style="@style/Widget.LiteSail.BrowserMenuAction"
                android:drawableTint="@color/browser_toolbar_icon"
                android:drawableTop="@drawable/ic_menu_incognito"
                android:enabled="false"
                android:text="@string/browser_menu_incognito" />

            <TextView
                style="@style/Widget.LiteSail.BrowserMenuItem"
                android:drawableTint="@color/browser_toolbar_icon"
                android:drawableTop="@drawable/ic_menu_night_mode"
                android:enabled="false"
                android:text="@string/browser_menu_night_mode" />

            <Button
                android:id="@+id/page_qr_code"
                style="@style/Widget.LiteSail.BrowserMenuAction"
                android:drawableTint="@color/browser_toolbar_icon"
                android:drawableTop="@drawable/ic_menu_qr_code"
                android:enabled="false"
                android:text="@string/browser_page_qr_code" />

            <ToggleButton
                android:id="@+id/ad_block"
                style="@style/Widget.LiteSail.BrowserMenuToggle"
                android:drawableTop="@drawable/ic_menu_ad_block"
                android:textOff="@string/browser_menu_ad_block"
                android:textOn="@string/browser_menu_ad_block" />

            <ToggleButton
                android:id="@+id/web_debug"
                style="@style/Widget.LiteSail.BrowserMenuToggle"
                android:drawableTop="@drawable/ic_menu_debug"
                android:textOff="@string/browser_menu_web_debug"
                android:textOn="@string/browser_menu_web_debug" />

            <Button
                android:id="@+id/open_settings"
                style="@style/Widget.LiteSail.BrowserMenuAction"
                android:drawableTint="@color/browser_toolbar_icon"
                android:drawableTop="@drawable/ic_menu_settings"
                android:enabled="false"
                android:text="@string/browser_menu_settings" />
        </GridLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="10dp"
        android:background="@color/start_page_search_border"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@android:color/transparent"
            android:contentDescription="@string/browser_menu_share"
            android:enabled="false"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_menu_share"
            android:tint="@color/browser_toolbar_icon" />

        <ImageButton
            android:id="@+id/close_menu"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/browser_address_background"
            android:contentDescription="@string/browser_menu_close"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_menu_close" />

        <ImageButton
            android:id="@+id/exit_browser"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_menu_exit"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_menu_exit"
            android:tooltipText="@string/browser_menu_exit" />
    </FrameLayout>
</LinearLayout>
