<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/history_query"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_search_history"
        android:drawablePadding="14dp"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:minHeight="52dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/start_page_search_text"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/delete_entry"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_search_history"
        android:src="@drawable/ic_delete_history" />
</LinearLayout>
