<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/browser_toolbar_background"
    android:baselineAligned="false"
    android:elevation="2dp"
    android:orientation="horizontal">

    <ViewStub
        android:id="@+id/browser_navigation_stub"
        android:layout="@layout/view_browser_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3" />

    <FrameLayout
        android:id="@+id/windows"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/browser_windows"
        android:focusable="true"
        android:minWidth="56dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_toolbar_window"
            android:tint="@color/browser_menu_foreground" />

        <TextView
            android:id="@+id/window_count"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:duplicateParentState="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:textColor="@color/browser_menu_foreground"
            android:textSize="11sp" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/open_menu"
        style="@style/Widget.LiteSail.ToolbarButton"
        android:contentDescription="@string/browser_menu"
        android:src="@drawable/ic_toolbar_menu" />
</LinearLayout>
