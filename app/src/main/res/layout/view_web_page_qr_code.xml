<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/qr_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/browser_page_qr_scan_hint"
            android:textColor="@color/start_page_search_text"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/qr_image"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/qr_result_card_background"
            android:contentDescription="@string/browser_page_qr_code"
            android:padding="10dp"
            android:scaleType="matrix" />
    </LinearLayout>
</ScrollView>
