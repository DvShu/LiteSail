<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/browser_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/browser"
                layout="@layout/view_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/start_page"
                layout="@layout/view_start_page" />

            <TextView
                android:id="@+id/exit_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="10dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/exit_hint_background"
                android:elevation="3dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:text="@string/confirm_browser_exit"
                android:textColor="@color/start_page_on_accent"
                android:textSize="14sp"
                android:visibility="invisible" />
        </FrameLayout>

        <include
            android:id="@+id/browser_toolbar"
            layout="@layout/view_browser_toolbar" />
    </LinearLayout>

    <include
        android:id="@+id/search_page"
        layout="@layout/view_search_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <include
        android:id="@+id/qr_result"
        layout="@layout/view_qr_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
