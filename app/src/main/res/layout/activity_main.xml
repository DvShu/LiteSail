<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/browser_shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ViewStub
                android:id="@+id/browser_stub"
                android:inflatedId="@+id/browser"
                android:layout="@layout/view_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ViewStub
                android:id="@+id/start_page_stub"
                android:inflatedId="@+id/start_page"
                android:layout="@layout/view_start_page"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ViewStub
                android:id="@+id/exit_hint_stub"
                android:inflatedId="@+id/exit_hint"
                android:layout="@layout/view_exit_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginHorizontal="24dp"
                android:layout_marginBottom="10dp" />
        </FrameLayout>

        <ViewStub
            android:id="@+id/browser_toolbar_stub"
            android:inflatedId="@+id/browser_toolbar"
            android:layout="@layout/view_browser_toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp" />
    </LinearLayout>

    <ViewStub
        android:id="@+id/search_page_stub"
        android:inflatedId="@+id/search_page"
        android:layout="@layout/view_search_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ViewStub
        android:id="@+id/qr_result_stub"
        android:inflatedId="@+id/qr_result"
        android:layout="@layout/view_qr_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ViewStub
        android:id="@+id/window_manager_stub"
        android:inflatedId="@+id/window_manager"
        android:layout="@layout/view_browser_windows"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
