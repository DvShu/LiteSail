<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/start_page_search_surface"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/downloads_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/downloads_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_search_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="52dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="@string/browser_menu_downloads"
            android:textColor="@color/start_page_brand_text"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/downloads_edit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/download_history_edit"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit_page_link" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/downloads_selection_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/downloads_select_all"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/download_history_select_all"
            android:saveEnabled="false" />

        <TextView
            android:id="@+id/downloads_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:textColor="@color/start_page_brand_text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/downloads_selection_done"
            style="@style/Widget.LiteSail.DownloadAction"
            android:layout_width="88dp"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="@string/download_history_selection_done" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/downloads_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="12dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/download_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/search_current_page_background"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_start_search"
            android:hint="@string/download_history_search"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/start_page_brand_text"
            android:textColorHint="@color/start_page_search_text"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/downloads_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/download_history_actions"
            android:src="@drawable/ic_toolbar_menu" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/download_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:overScrollMode="ifContentScrolls"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/download_list_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/download_history_loading"
            android:textColor="@color/start_page_search_text"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/downloads_selection_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/browser_toolbar_background"
        android:baselineAligned="false"
        android:clipToOutline="true"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/downloads_selection_delete"
            style="@style/Widget.LiteSail.DownloadSelectionAction"
            android:drawableTop="@drawable/ic_delete_history"
            android:text="@string/download_history_delete" />

        <Button
            android:id="@+id/downloads_selection_more"
            style="@style/Widget.LiteSail.DownloadSelectionAction"
            android:drawableTop="@drawable/ic_more_vertical"
            android:text="@string/download_history_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storage_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/start_page_background"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_storage_directory"
            android:textColor="@color/start_page_brand_text"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/storage_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressBackgroundTint="@color/start_page_search_border"
            android:progressTint="@color/start_page_accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/storage_amounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/storage_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/start_page_search_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/storage_free"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/start_page_search_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
