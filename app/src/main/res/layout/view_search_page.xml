<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp">

        <ImageButton
            android:id="@+id/close_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_search_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:background="@drawable/start_search_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <EditText
                android:id="@+id/query"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_start_search"
                android:drawablePadding="10dp"
                android:hint="@string/start_search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/start_page_brand_text"
                android:textColorHint="@color/start_page_search_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/submit_search"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/search_action"
                android:textColor="@color/start_page_accent" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/shortcut_https"
                style="@style/Widget.LiteSail.UrlShortcut"
                android:text="@string/url_shortcut_https" />

            <Button
                android:id="@+id/shortcut_http"
                style="@style/Widget.LiteSail.UrlShortcut"
                android:text="@string/url_shortcut_http" />

            <Button
                android:id="@+id/shortcut_com"
                style="@style/Widget.LiteSail.UrlShortcut"
                android:text="@string/url_shortcut_com" />

            <Button
                android:id="@+id/shortcut_cn"
                style="@style/Widget.LiteSail.UrlShortcut"
                android:text="@string/url_shortcut_cn" />

            <Button
                android:id="@+id/shortcut_slash"
                style="@style/Widget.LiteSail.UrlShortcut"
                android:contentDescription="@string/insert_url_slash"
                android:text="@string/url_shortcut_slash" />

            <Button
                android:id="@+id/shortcut_dot"
                style="@style/Widget.LiteSail.UrlShortcut"
                android:contentDescription="@string/insert_url_dot"
                android:text="@string/url_shortcut_dot" />

            <Button
                android:id="@+id/shortcut_www"
                style="@style/Widget.LiteSail.UrlShortcut"
                android:text="@string/url_shortcut_www" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/search_history"
            android:textColor="@color/start_page_brand_text"
            android:textSize="18sp" />

        <Button
            android:id="@+id/clear_history"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:text="@string/clear_search_history"
            android:textColor="@color/start_page_accent"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:paddingTop="12dp"
        android:text="@string/empty_search_history"
        android:textColor="@color/start_page_search_text"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@color/start_page_search_border"
        android:dividerHeight="1dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp" />
</LinearLayout>
