<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp">

        <ImageButton
            android:id="@+id/close_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_search_back" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:background="@drawable/start_search_background"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <EditText
                android:id="@+id/query"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_start_search"
                android:drawablePadding="10dp"
                android:hint="@string/start_search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="56dp"
                android:paddingStart="14dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/start_page_brand_text"
                android:textColorHint="@color/start_page_search_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/submit_search"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/search_action"
                android:textColor="@color/start_page_accent" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/current_page_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/search_current_page_background"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/current_page_icon"
            android:layout_width="@dimen/site_icon_size"
            android:layout_height="@dimen/site_icon_size"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_start_search" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/current_page_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/start_page_brand_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/current_page_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/start_page_search_text"
                android:textDirection="ltr"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/copy_page_link"
            style="@style/Widget.LiteSail.SearchLinkButton"
            android:drawableTop="@drawable/ic_copy_page_link"
            android:text="@string/copy_page_link" />

        <Button
            android:id="@+id/edit_page_link"
            style="@style/Widget.LiteSail.SearchLinkButton"
            android:drawableTop="@drawable/ic_edit_page_link"
            android:text="@string/edit_page_link" />
    </LinearLayout>

    <com.joel.litesail.search.ShortcutFlowLayout
        android:id="@+id/search_shortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/shortcut_cursor_left"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:contentDescription="@string/search_cursor_left"
            android:text="@string/search_cursor_left_symbol"
            android:textSize="18sp" />

        <Button
            android:id="@+id/shortcut_cursor_right"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:contentDescription="@string/search_cursor_right"
            android:text="@string/search_cursor_right_symbol"
            android:textSize="18sp" />

        <Button
            android:id="@+id/shortcut_https"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:text="@string/url_shortcut_https" />

        <Button
            android:id="@+id/shortcut_http"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:text="@string/url_shortcut_http" />

        <Button
            android:id="@+id/shortcut_com"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:text="@string/url_shortcut_com" />

        <Button
            android:id="@+id/shortcut_cn"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:text="@string/url_shortcut_cn" />

        <Button
            android:id="@+id/shortcut_slash"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:contentDescription="@string/insert_url_slash"
            android:text="@string/url_shortcut_slash" />

        <Button
            android:id="@+id/shortcut_dot"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:contentDescription="@string/insert_url_dot"
            android:text="@string/url_shortcut_dot" />

        <Button
            android:id="@+id/shortcut_www"
            style="@style/Widget.LiteSail.UrlShortcut"
            android:text="@string/url_shortcut_www" />
    </com.joel.litesail.search.ShortcutFlowLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/search_history"
            android:textColor="@color/start_page_brand_text"
            android:textSize="18sp" />

        <Button
            android:id="@+id/clear_history"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:text="@string/clear_search_history"
            android:textColor="@color/start_page_accent"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:paddingTop="12dp"
        android:text="@string/empty_search_history"
        android:textColor="@color/start_page_search_text"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@color/start_page_search_border"
        android:dividerHeight="1dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp" />
</LinearLayout>
