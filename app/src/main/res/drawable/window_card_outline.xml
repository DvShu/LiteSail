<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/start_page_search_ripple">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <corners android:radius="18dp" />
                    <stroke android:width="2dp" android:color="@color/start_page_accent" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="18dp" />
                    <stroke android:width="1dp" android:color="@color/start_page_search_border" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="@color/start_page_search_surface" />
        </shape>
    </item>
</ripple>
