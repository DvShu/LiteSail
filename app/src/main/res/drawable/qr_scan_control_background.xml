<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/scanner_control_ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <corners android:radius="24dp" />
                    <solid android:color="@color/scanner_control_active" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="24dp" />
                    <solid android:color="@color/scanner_control" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
