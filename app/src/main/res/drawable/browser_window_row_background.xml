<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/start_page_search_ripple">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="@color/start_page_glow" />
                    <stroke android:width="1dp" android:color="@color/start_page_accent" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14dp" />
                    <solid android:color="@color/start_page_search_surface" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
